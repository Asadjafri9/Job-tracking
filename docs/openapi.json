{
  "components": {
    "schemas": {
      "ApiMetaResponse": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "v1",
            "title": "Api Version",
            "type": "string"
          },
          "contract_version": {
            "const": 1,
            "title": "Contract Version",
            "type": "integer"
          },
          "minimum_compatible_client_version": {
            "title": "Minimum Compatible Client Version",
            "type": "string"
          }
        },
        "required": [
          "api_version",
          "contract_version",
          "minimum_compatible_client_version"
        ],
        "title": "ApiMetaResponse",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field_errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorField"
            },
            "title": "Field Errors",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "field_errors"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorField": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "ErrorField",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Dependencies",
            "type": "object"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "unverified": {
            "items": {
              "type": "string"
            },
            "title": "Unverified",
            "type": "array"
          }
        },
        "required": [
          "status",
          "service",
          "dependencies",
          "unverified"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      }
    }
  },
