# Local-only settings. These credentials and keys must never be reused outside local/test.
APP_ENV=local
POSTGRES_HOST_PORT=55432
AZURITE_BLOB_HOST_PORT=11000
AZURITE_QUEUE_HOST_PORT=11001
AZURITE_TABLE_HOST_PORT=11002
# If either host port changes, update the matching connection URL below as well.
POSTGRES_ADMIN_PASSWORD=local-admin-only
DATABASE_URL=postgresql://copilot_runtime:runtime-local-only@127.0.0.1:55432/jobtracking
AUTH_DATABASE_URL=postgresql://copilot_auth:auth-local-only@127.0.0.1:55432/jobtracking
WORKER_DATABASE_URL=postgresql://copilot_worker:worker-local-only@127.0.0.1:55432/jobtracking
MIGRATION_DATABASE_URL=postgresql://copilot_migrator:migrator-local-only@127.0.0.1:55432/jobtracking
BLOB_ENDPOINT_URL=http://127.0.0.1:11000/devstoreaccount1
OIDC_ISSUER=http://127.0.0.1:18101/oidc
OIDC_CLIENT_ID=job-tracking-local
OIDC_CLIENT_SECRET=mock-client-secret
OIDC_REDIRECT_URI=http://127.0.0.1:18000/auth/callback
WEB_APP_ORIGIN=http://127.0.0.1:5173
BETA_ALLOWED_EMAILS=local.user@example.test
CHROME_EXTENSION_IDS=digpnmcecpkodggeieillcjpfgpokgnk
LOCAL_MOCKS_ENABLED=true
CREDENTIAL_KEK_PROVIDER=local
CREDENTIAL_KEK_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
